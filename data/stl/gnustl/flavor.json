{
  "format": 1,
  "name": "gnustl",
  "title": "GNU libstdc++ (gnustl)",
  "description": "Android up to GD 2.208x. A hand-written model of the layouts IDA needs: the old copy-on-write std::string, _Rb_tree maps, _Hashtable unordered containers. Some helper code is borrowed from libc++.",
  "provides": [
    "std::string",
    "std::wstring",
    "std::basic_string",
    "std::vector",
    "std::list",
    "std::map",
    "std::set",
    "std::unordered_map",
    "std::unordered_set",
    "std::array",
    "std::pair",
    "std::tuple",
    "std::mutex",
    "std::atomic",
    "std::atomic_bool",
    "std::atomic_char",
    "std::atomic_schar",
    "std::atomic_uchar",
    "std::atomic_short",
    "std::atomic_ushort",
    "std::atomic_int",
    "std::atomic_uint",
    "std::atomic_long",
    "std::atomic_ulong",
    "std::atomic_llong",
    "std::atomic_ullong",
    "std::size_t",
    "std::ptrdiff_t",
    "std::intptr_t",
    "std::uintptr_t",
    "std::int8_t",
    "std::int16_t",
    "std::int32_t",
    "std::int64_t",
    "std::uint8_t",
    "std::uint16_t",
    "std::uint32_t",
    "std::uint64_t"
  ]
}
