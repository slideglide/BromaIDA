#pragma once
#pragma clang system_header

// only the layout matters to IDA: the MSVC STL's std::mutex holds an _Mtx_internal_imp_t, which is 80 bytes and
// 8-byte aligned on x64 (up to the VS 2022 17.9 toolset; newer ones moved to an 8-byte SRWLOCK).
// ASSUMPTION: this was not verified against a Windows binary of the game. If the members after a std::mutex look
// misplaced in the Windows types, this size is the thing to adjust.

namespace std
{
	class mutex
	{
	public:
		alignas(8) unsigned char __native[80];
	};
}
